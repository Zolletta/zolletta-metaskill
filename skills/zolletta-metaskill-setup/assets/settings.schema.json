{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zolletta-metaskill/schemas/settings.schema.json",
  "title": "Zolletta-metaskill settings.json",
  "description": "Project-wide configuration written by /zolletta-metaskill setup and read by every other subcommand. The prose documentation lives in docs/reference/settings-schema.md — this schema is the machine-readable counterpart. Keep both in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "setup_version",
    "setup_timestamp",
    "language",
    "container_name",
    "tokensave_available",
    "acronyms",
    "python",
    "php",
    "subcommands",
    "documentation",
    "runs_dir"
  ],
  "properties": {
    "setup_version": {
      "type": "string",
      "description": "Matches the skill version that wrote the file."
    },
    "setup_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last setup run."
    },
    "language": {
      "type": "string",
      "description": "Detected project language (lowercase).",
      "enum": ["", "python", "php", "typescript", "javascript", "go", "rust", "java", "kotlin", "ruby", "c", "cpp", "csharp", "swift", "scala", "other"]
    },
    "container_name": {
      "type": ["string", "null"],
      "description": "Docker container name for running tools. null if no Docker."
    },
    "tokensave_available": {
      "type": "boolean",
      "description": "true if tokensave_status responds (probed directly)."
    },
    "acronyms": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Project-specific acronyms that must stay uppercase in class names (e.g. [\"CITE\"]). Extracted from AGENTS.md during setup. Always present, even for non-Python projects.",
      "default": []
    },
    "python": {
      "$ref": "#/$defs/python",
      "description": "Python tooling, rule toggles, and effective tool configuration. null for non-Python projects."
    },
    "php": {
      "$ref": "#/$defs/php",
      "description": "PHP tooling, rule toggles, autoload mapping, and effective tool configuration. null for non-PHP projects."
    },
    "subcommands": {
      "$ref": "#/$defs/subcommands",
      "description": "Per-subcommand configuration. Each key is a subcommand name; each value is an object with a `model` field."
    },
    "documentation": {
      "$ref": "#/$defs/documentation",
      "description": "Documentation configuration."
    },
    "runs_dir": {
      "type": "string",
      "description": "Directory where review run folders are created. Each run gets a timestamped subdirectory (<runs_dir>/<YYYY-MM-DD-HH-MM>/) containing reports/ and cache/.",
      "default": ".zolletta-metaskill"
    }
  },

  "$defs": {

    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "dir",
        "adrs",
        "min_severity",
        "staleness_threshold",
        "readme_focus",
        "readme_sections",
        "diataxis_translations",
        "staleness_weights",
        "doc_patterns",
        "check_external",
        "include_referential",
        "api_doc_recursive",
        "api_doc_include_private",
        "api_doc_suggest_coverage"
      ],
      "properties": {
        "language": {
          "type": "string",
          "description": "ISO 639-1 code for documentation language (default: en). When not en, the documentor skill translates Diataxis signpost headings.",
          "default": "en"
        },
        "dir": {
          "type": "string",
          "description": "Directory where project documentation lives (default: docs). Used by the documentor skill to locate the Diataxis docs tree.",
          "default": "docs"
        },
        "adrs": {
          "type": ["string", "null"],
          "description": "Relative path within documentation.dir where ADRs live (e.g. \"adr\"), \"\" if scattered in docs root, or null if no ADRs found. Auto-detected during setup.",
          "default": null
        },
        "min_severity": {
          "type": "string",
          "enum": ["critical", "high", "medium", "low", "info"],
          "description": "Minimum severity reported by drift_analyzer (default: high).",
          "default": "high"
        },
        "staleness_threshold": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100,
          "description": "If set, doc_staleness_scorer exits 1 when the freshness score falls below this value. null = report-only (default).",
          "default": null
        },
        "readme_focus": {
          "type": "boolean",
          "description": "When true, doc_staleness_scorer only scores the README (default: false).",
          "default": false
        },
        "readme_sections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Section names a README is expected to contain, checked by doc_staleness_scorer's completeness dimension.",
          "default": ["installation", "usage", "api", "contributing", "license"]
        },
        "diataxis_translations": {
          "type": ["string", "null"],
          "description": "Path to a JSON file mapping Diataxis signpost headings to translations (used when documentation.language is not en). null = built-in translations.",
          "default": null
        },
        "staleness_weights": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Custom dimension weights for doc_staleness_scorer (normalized to sum 1.0). null = built-in defaults.",
          "properties": {
            "last_updated":       { "type": "number" },
            "code_doc_alignment": { "type": "number" },
            "link_health":        { "type": "number" },
            "completeness":       { "type": "number" },
            "accuracy":           { "type": "number" }
          },
          "default": null
        },
        "doc_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Glob patterns for documentation files scanned by drift_analyzer.",
          "default": ["*.md", "*.rst", "*.txt", "*.adoc"]
        },
        "check_external": {
          "type": "boolean",
          "description": "When true, link_checker verifies external http(s) links too (default: false — external links are skipped).",
          "default": false
        },
        "include_referential": {
          "type": "boolean",
          "description": "When true, drift_analyzer also reports referential drift (docs referencing symbols that moved), not just broken links.",
          "default": false
        },
        "api_doc_recursive": {
          "type": "boolean",
          "description": "When true, api_doc_validator scans source roots recursively (default: true).",
          "default": true
        },
        "api_doc_include_private": {
          "type": "boolean",
          "description": "When true, api_doc_validator also checks private/underscore modules (default: false).",
          "default": false
        },
        "api_doc_suggest_coverage": {
          "type": "boolean",
          "description": "When true, api_doc_validator suggests a documentation coverage target based on public API surface (default: false).",
          "default": false
        }
      }
    },
    "subcommands": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-subcommand configuration. Each key is a subcommand name; each value is an object with a `model` field (string|null, null = harness default). Profile/model ids are harness-specific; the skill never hardcodes one. The review orchestrator reads each subcommand's model and passes it to run_subagent.",
      "required": ["patterns", "documentor", "python-code-style", "python-testing-style", "php-code-style", "php-testing-style"],
      "properties": {
        "patterns":              { "$ref": "#/$defs/subcommand_entry" },
        "documentor":            { "$ref": "#/$defs/subcommand_entry" },
        "python-code-style":     { "$ref": "#/$defs/subcommand_entry" },
        "python-testing-style":  { "$ref": "#/$defs/subcommand_entry" },
        "php-code-style":        { "$ref": "#/$defs/subcommand_entry" },
        "php-testing-style":     { "$ref": "#/$defs/subcommand_entry" }
      }
    },

    "subcommand_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": {
          "type": ["string", "null"],
          "description": "Harness-specific profile/model id for this subcommand. null = harness default. The user supplies a value that exists in their harness; the skill never hardcodes one.",
          "default": null
        }
      }
    },

    "python": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "paths", "code_style", "testing", "patterns", "pyproject_mtime"],
          "properties": {
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uv", "ruff", "pytest", "ty", "vulture", "mypy"],
              "properties": {
                "uv":      { "$ref": "#/$defs/python_tools_uv" },
                "ruff":    { "$ref": "#/$defs/python_tools_ruff" },
                "pytest":  { "$ref": "#/$defs/python_tools_pytest" },
                "ty":      { "$ref": "#/$defs/python_tools_ty" },
                "vulture": { "$ref": "#/$defs/python_tools_vulture" },
                "mypy":    { "$ref": "#/$defs/python_tools_mypy" }
              }
            },
            "paths":      { "$ref": "#/$defs/python_paths" },
            "code_style": { "$ref": "#/$defs/python_code_style" },
            "testing":    { "$ref": "#/$defs/python_testing" },
            "patterns":   { "$ref": "#/$defs/python_patterns" },
            "pyproject_mtime": {
              "type": "number",
              "description": "Modification time of pyproject.toml at last extraction (Unix timestamp). The setup guard uses it to detect staleness and trigger a light refresh."
            }
          }
        }
      ]
    },

    "python_tools_uv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" }
      }
    },

    "python_tools_ruff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "line_length", "target_version", "select", "ignore"],
      "properties": {
        "available":      { "type": "boolean" },
        "line_length":    { "type": "integer", "minimum": 1 },
        "target_version": { "type": "string", "description": "e.g. py312, py310" },
        "select":         { "type": "array", "items": { "type": "string" } },
        "ignore":         { "type": "array", "items": { "type": "string" } }
      }
    },

    "python_tools_pytest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "addopts", "testpaths", "minversion"],
      "properties": {
        "available":   { "type": "boolean" },
        "addopts":     { "type": "array", "items": { "type": "string" } },
        "testpaths":   { "type": "array", "items": { "type": "string" } },
        "minversion":  { "type": ["string", "null"] }
      }
    },

    "python_tools_ty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "python_version"],
      "properties": {
        "available":       { "type": "boolean" },
        "python_version":  { "type": ["string", "null"] }
      }
    },

    "python_tools_vulture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {
        "available": { "type": "boolean" }
      }
    },

    "python_tools_mypy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "strict", "python_version"],
      "properties": {
        "available":      { "type": "boolean" },
        "strict":         { "type": "boolean" },
        "python_version": { "type": ["string", "null"] }
      }
    },

    "python_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "tests", "package"],
      "properties": {
        "source": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Source roots scanned by every review script (the PHP-autoload equivalent Python lacked). Detected from pyproject.toml build config / layout by setup's python_paths_detector.",
          "default": ["src"]
        },
        "tests": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Test roots scanned by test scanners. Detected from pytest testpaths or the tests/ directory.",
          "default": ["tests"]
        },
        "package": {
          "type": ["string", "null"],
          "description": "Top-level package name used by mirror-structure checks (naming_conventions, test_structure). null when undetected.",
          "default": null
        }
      }
    },

    "python_code_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_acronym_casing",
        "check_no_relative_imports",
        "check_one_class_per_file",
        "check_one_class_per_test_file",
        "check_zero_class_files",
        "check_filename_matches_class",
        "check_public_docstrings",
        "check_docstring_no_type_repeat",
        "check_skip_obvious_docstrings",
        "check_line_length",
        "check_file_length",
        "check_unused_all_exports",
        "docstring_strip_private",
        "docstring_strip_tests",
        "docstring_strip_nested",
        "docstring_strip_obvious_init",
        "vulture_min_confidence"
      ],
      "properties": {
        "check_acronym_casing":           { "type": "boolean", "default": true },
        "check_no_relative_imports":      { "type": "boolean", "default": true },
        "check_one_class_per_file":       { "type": "boolean", "default": true },
        "check_one_class_per_test_file":  { "type": "boolean", "default": true, "description": "one_class_per_file_scanner also scans test roots: one test class per test file, named after its stem (test_user.py -> TestUser). Set false to skip test files." },
        "check_zero_class_files":         { "type": "boolean", "default": true, "description": "Report files with 0 classes (utility/helper modules). Replaces the removed --ignore-zero flag — set false to hide them." },
        "check_filename_matches_class":   { "type": "boolean", "default": true },
        "check_public_docstrings":        { "type": "boolean", "default": true },
        "check_docstring_no_type_repeat": { "type": "boolean", "default": true },
        "check_skip_obvious_docstrings":  { "type": "boolean", "default": true },
        "check_line_length":              { "type": "boolean", "default": true },
        "check_file_length":              { "type": "boolean", "default": true },
        "check_unused_all_exports":       { "type": "boolean", "default": true },
        "docstring_strip_private":        { "type": "boolean", "default": false, "description": "docstring_streamliner removes docstrings from private functions when applying fixes." },
        "docstring_strip_tests":          { "type": "boolean", "default": false, "description": "docstring_streamliner removes docstrings from test functions when applying fixes." },
        "docstring_strip_nested":         { "type": "boolean", "default": false, "description": "docstring_streamliner removes docstrings from nested functions when applying fixes." },
        "docstring_strip_obvious_init":   { "type": "boolean", "default": false, "description": "docstring_streamliner removes obvious __init__ docstrings when applying fixes." },
        "max_file_length":                { "type": "integer", "minimum": 1, "default": 800 },
        "vulture_min_confidence":         { "type": "integer", "minimum": 0, "maximum": 100, "default": 80 }
      }
    },

    "python_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_gap_threshold",
        "coverage_well_covered_threshold",
        "check_test_naming",
        "test_naming_min_segments"
      ],
      "properties": {
        "coverage_gap_threshold":          { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
        "coverage_well_covered_threshold": { "type": "integer", "minimum": 0, "maximum": 100, "default": 80 },
        "check_test_naming":               { "type": "boolean", "default": true },
        "test_naming_min_segments":        { "type": "integer", "minimum": 1, "default": 3, "description": "Minimum number of underscore-separated segments a test function name must have (test_naming_scanner). Replaces the removed --min-segments flag." }
      }
    },

    "python_patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_ocp",
        "check_isp",
        "check_dip",
        "check_lsp",
        "check_test_structure",
        "ocp_min_branches",
        "isp_min_methods",
        "dip_entry_points",
        "class_metrics_top",
        "class_metrics_min_lines",
        "test_god_classes_top"
      ],
      "properties": {
        "check_ocp":              { "type": "boolean", "default": true, "description": "Open/closed principle check (open_closed_scanner)." },
        "check_isp":              { "type": "boolean", "default": true, "description": "Interface segregation check (interface_segregation_scanner)." },
        "check_dip":              { "type": "boolean", "default": true, "description": "Dependency inversion check (dependency_inversion_scanner)." },
        "check_lsp":              { "type": "boolean", "default": true, "description": "Liskov substitution check (liskov_substitution_scanner)." },
        "check_test_structure":   { "type": "boolean", "default": true, "description": "Mirror-structure check between source and test trees (test_structure_scanner)." },
        "ocp_min_branches":       { "type": "integer", "minimum": 1, "default": 3, "description": "Minimum branches in an if/elif chain before open_closed_scanner flags it." },
        "isp_min_methods":        { "type": "integer", "minimum": 1, "default": 5, "description": "Minimum methods on an interface/class before interface_segregation_scanner flags it." },
        "dip_entry_points":       { "type": "array", "items": { "type": "string" }, "description": "Module names treated as composition roots — exempt from dependency_inversion_scanner findings.", "default": ["main", "cli", "app", "__main__", "myproject", "manage", "wsgi", "asgi", "conftest"] },
        "class_metrics_top":      { "type": "integer", "minimum": 1, "default": 30, "description": "How many largest classes class_metrics_scanner reports." },
        "class_metrics_min_lines": { "type": "integer", "minimum": 1, "default": 50, "description": "Minimum class size (lines) class_metrics_scanner reports." },
        "test_god_classes_top":   { "type": "integer", "minimum": 1, "default": 30, "description": "How many largest test classes test_god_classes_scanner reports." }
      }
    },

    "php": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools", "code_style", "testing", "patterns", "autoload", "php_version", "composer_mtime"],
          "properties": {
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phpunit", "phpstan", "psalm", "php_cs_fixer", "phpcs"],
              "properties": {
                "phpunit":      { "$ref": "#/$defs/php_tools_phpunit" },
                "phpstan":      { "$ref": "#/$defs/php_tools_phpstan" },
                "psalm":        { "$ref": "#/$defs/php_tools_psalm" },
                "php_cs_fixer": { "$ref": "#/$defs/php_tools_php_cs_fixer" },
                "phpcs":        { "$ref": "#/$defs/php_tools_phpcs" }
              }
            },
            "code_style":     { "$ref": "#/$defs/php_code_style" },
            "testing":        { "$ref": "#/$defs/php_testing" },
            "patterns":       { "$ref": "#/$defs/php_patterns" },
            "autoload":       { "$ref": "#/$defs/php_autoload" },
            "php_version":    { "type": ["string", "null"], "description": "Minimum PHP version extracted from composer.json require.php (e.g. 8.2). null if unknown." },
            "composer_mtime": { "type": "number", "description": "Modification time of composer.json at last extraction (Unix timestamp). The setup guard uses it to detect staleness and trigger a light refresh." }
          }
        }
      ]
    },

    "php_tools_phpunit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "bootstrap", "testpaths", "coverage_config"],
      "properties": {
        "available":       { "type": "boolean" },
        "bootstrap":       { "type": ["string", "null"], "description": "Path to the bootstrap file (e.g. vendor/autoload.php). null if not configured." },
        "testpaths":       { "type": "array", "items": { "type": "string" } },
        "coverage_config": { "type": ["boolean", "null"], "description": "true if phpunit.xml configures coverage, false/null otherwise." }
      }
    },

    "php_tools_phpstan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "level", "paths", "memory_limit"],
      "properties": {
        "available":     { "type": "boolean" },
        "level":         { "type": ["integer", "null"], "minimum": 0, "maximum": 9, "description": "PHPStan analysis level (0-9). null if config could not be read." },
        "paths":         { "type": "array", "items": { "type": "string" } },
        "memory_limit":  { "type": ["string", "null"], "description": "e.g. 256M. null if not configured." }
      }
    },

    "php_tools_psalm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "error_level", "paths"],
      "properties": {
        "available":    { "type": "boolean" },
        "error_level":  { "type": ["integer", "null"], "minimum": 1, "maximum": 8, "description": "Psalm error level (1-8). null if config could not be read." },
        "paths":        { "type": "array", "items": { "type": "string" } }
      }
    },

    "php_tools_php_cs_fixer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "config_file"],
      "properties": {
        "available":   { "type": "boolean" },
        "config_file": { "type": "boolean", "description": "true if .php-cs-fixer.php or .php-cs-fixer.dist.php exists. The file is PHP code and cannot be parsed by setup — the php-code-style skill reads it at review time." }
      }
    },

    "php_tools_phpcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "standard"],
      "properties": {
        "available": { "type": "boolean" },
        "standard":  { "type": ["string", "null"], "description": "Coding standard (e.g. PSR12, Custom). null if not configured." }
      }
    },

    "php_patterns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_ocp",
        "check_isp",
        "check_dip",
        "ocp_min_branches",
        "isp_min_methods"
      ],
      "properties": {
        "check_ocp":        { "type": "boolean", "default": true, "description": "Open/closed principle check (open_closed_scanner)." },
        "check_isp":        { "type": "boolean", "default": true, "description": "Interface segregation check (interface_segregation_scanner)." },
        "check_dip":        { "type": "boolean", "default": true, "description": "Dependency inversion check (dependency_inversion_scanner)." },
        "ocp_min_branches": { "type": "integer", "minimum": 1, "default": 3, "description": "Minimum branches in an if/elseif chain before open_closed_scanner flags it." },
        "isp_min_methods":  { "type": "integer", "minimum": 1, "default": 7, "description": "Minimum methods on an interface/class before interface_segregation_scanner flags it. PHP default is 7 (higher than Python's 5)." }
      }
    },

    "php_code_style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_acronym_casing",
        "check_union_types",
        "check_intersection_types",
        "check_enum_methods",
        "check_first_class_callables",
        "check_readonly_classes",
        "check_typed_constants",
        "check_override_attribute",
        "check_property_hooks",
        "check_asymmetric_visibility",
        "check_pipe_operator",
        "check_array_functions",
        "check_string_functions",
        "check_file_length",
        "max_file_length"
      ],
      "properties": {
        "check_acronym_casing":         { "type": "boolean", "default": true },
        "check_union_types":            { "type": "boolean", "default": true },
        "check_intersection_types":     { "type": "boolean", "default": true },
        "check_enum_methods":           { "type": "boolean", "default": true },
        "check_first_class_callables":  { "type": "boolean", "default": true },
        "check_readonly_classes":       { "type": "boolean", "default": true },
        "check_typed_constants":        { "type": "boolean", "default": true },
        "check_override_attribute":     { "type": "boolean", "default": true },
        "check_property_hooks":         { "type": "boolean", "default": true },
        "check_asymmetric_visibility":  { "type": "boolean", "default": true },
        "check_pipe_operator":          { "type": "boolean", "default": true },
        "check_array_functions":        { "type": "boolean", "default": true },
        "check_string_functions":       { "type": "boolean", "default": true },
        "check_file_length":            { "type": "boolean", "default": true },
        "max_file_length":              { "type": "integer", "minimum": 1, "default": 800 }
      }
    },

    "php_testing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_gap_threshold",
        "coverage_well_covered_threshold",
        "check_test_naming"
      ],
      "properties": {
        "coverage_gap_threshold":          { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
        "coverage_well_covered_threshold": { "type": "integer", "minimum": 0, "maximum": 100, "default": 80 },
        "check_test_naming":               { "type": "boolean", "default": true }
      }
    },

    "php_autoload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["psr-4", "psr-4-dev"],
      "properties": {
        "psr-4": {
          "type": "object",
          "description": "Production namespace to directory mapping from composer.json autoload.psr-4 (e.g. {\"App\\\\\": \"src/\"}). Empty object if absent.",
          "additionalProperties": { "type": "string" }
        },
        "psr-4-dev": {
          "type": "object",
          "description": "Test namespace to directory mapping from composer.json autoload-dev.psr-4 (e.g. {\"Tests\\\\\": \"tests/\"}). Empty object if absent.",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
