{
  "//": "markdownlint-cli2 configuration. Rule settings live in .markdownlint.yaml; this file holds only the file list and the exclusions.",

  "config": {
    "default": true,
    "//MD013": "disabled in .markdownlint.yaml — it contradicts the no-artificial-line-break convention",
    "extends": null
  },

  "globs": ["docs/**/*.md", "*.md", "skills/**/*.md"],

  "//ignores": "Every file the gate does not cover, and why. Adding an entry here is a decision to review, not a place to hide a violation.",
  "ignores": [
    "CHANGELOG.md"
  ],

  "//ignore-reasons": {
    "CHANGELOG.md": "Regenerated by python-semantic-release on every release. Editing it by hand is undone at the next release, and the MD012 double blank lines it carries are the generator's output, not ours. .gitignore also keeps mutants/ and the skill cache out of every glob above."
  }
}
