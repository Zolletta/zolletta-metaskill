{
  "//": "markdownlint-cli2 configuration. Rule settings live in .markdownlint.yaml; this file holds only the file list and the exclusions.",

  "config": {
    "default": true,
    "//MD013": "disabled in .markdownlint.yaml — it contradicts the no-artificial-line-break convention",
    "extends": null
  },

  "//customRules": "markdownlint ships no frontmatter rule, so the docs/reference/frontmatter.md convention is gated by a local custom rule. It fires on any file the globs select without a leading `---` block; the only exemption is the per-file `ignores` entry below.",
  "customRules": ["./md-require-frontmatter.js"],

  "globs": ["docs/**/*.md", "*.md", "skills/**/*.md"],

  "//ignores": "Every file the gate does not cover, and why. Adding an entry here is a decision to review, not a place to hide a violation.",
  "ignores": [
    "CHANGELOG.md",
    "TODO.md",
    "skills/zolletta-metaskill/docs",
    "skills/zolletta-metaskill/README.md",
    "skills/zolletta-metaskill/CONTRIBUTING.md"
  ],

  "//ignore-reasons": {
    "CHANGELOG.md": "Regenerated by python-semantic-release on every release. Editing it by hand is undone at the next release, and the MD012 double blank lines it carries are the generator's output, not ours. .gitignore also keeps mutants/ and the skill cache out of every glob above.",
    "TODO.md": "A gitignored scratch TODO at the repository root — not the plan at .zolletta-metaskill/plans/TODO.md, which is outside the globs. It carries no frontmatter and cannot be committed with any, so the gate must not depend on untracked local state.",
    "skills/zolletta-metaskill/docs": "GENERATED — copies produced by sync-bundle.sh from docs/. Linting them twice is noise, and the copy-time `skills/zolletta-metaskill/` path strip can even introduce violations the aligned source never had (MD060). The real source under docs/ is what gets linted.",
    "skills/zolletta-metaskill/README.md": "GENERATED — copy of the root README.md; same reasoning as the docs/ copies.",
    "skills/zolletta-metaskill/CONTRIBUTING.md": "GENERATED — copy of the root CONTRIBUTING.md; same reasoning as the docs/ copies."
  }
}
